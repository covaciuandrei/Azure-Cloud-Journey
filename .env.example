# The public-source demo needs no Firebase credentials.
# For the real project, put its Firebase web API key in .env.local.
# Web configuration is public in the built client; Firebase rules enforce access.
VITE_FIREBASE_API_KEY=

# Server-side publishing commands require an explicitly approved administrator.
# Do not prefix this value with VITE_ or commit your real account address.
AZURE_CLOUD_JOURNEY_ADMIN_EMAIL=

# Set GOOGLE_APPLICATION_CREDENTIALS in your shell to an isolated ADC file
# outside this repository. Never paste its contents into this file.
